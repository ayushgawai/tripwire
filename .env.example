# Tripwire environment template.
# Copy this file to .env in the repo root and fill in values locally.
# NEVER commit .env. Share keys only via a private channel (DM), never in chat/issues/docs.
# Verify keys with: python -m backend.audio.provider_checks.run_all

# Daily (WebRTC rooms) - used by Manav (voice worker)
DAILY_API_KEY=

# Deepgram (speech-to-text) - used by Manav (voice worker STT) and Pratham (transcripts)
DEEPGRAM_API_KEY=

# Gemini (LLM) - used by Pratham (risk scoring) and Manav (dialogue)
GEMINI_API_KEY=
GEMINI_MODEL=

# ElevenLabs (text-to-speech) - used by Manav (voice worker TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Backend URLs - used by backend services and the Next.js frontend
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Demo mode - used by everyone (scripted fallback for the live demo)
DEMO_MODE=false

# Wearable / audio adapter (Naman, added - not in plan)
# AUDIO_SOURCE: wearable | laptop | file
AUDIO_SOURCE=laptop
AUDIO_FILE_PATH=
